{ pkgs }:
# Cross-build of CPython 3.14 targeting x86_64-w64-mingw32, using the
# msys2-contrib `cpython-mingw` patch set (105 patches as of MSYS2's
# mingw-w64-python 3.14.6-1). MSYS2 actively maintains a working mingw
# port across every Python release; that's the only sane source of
# truth for "what does CPython need to build on mingw at version X".
#
# nixpkgs' default `python314` is marked broken for mingw and bundles
# Fedora's 13-patch set that only applies to 3.11.x. We:
#   - bump src to 3.14.6 (MSYS2's tracked release; patches are pinned
#     against this exact version)
#   - replace nixpkgs' mingw-python3_*.patch list with the 105 MSYS2
#     patches under `./python-windows-patches/`
#   - lift the `broken` meta gate
let
  lib = pkgs.lib;
  msys2Patches =
    let
      dir = ./python-windows-patches;
      names = builtins.attrNames (builtins.readDir dir);
    in
    map (n: dir + "/${n}") (
      builtins.filter (lib.hasSuffix ".patch") names
    );
  # Recursive `self` override so the passthru-captured `withPackages`
  # (and the `pythonOnBuildFor*` splices) close over the post-
  # overrideAttrs derivation. Without this, `python.withPackages`
  # constructs a derivation whose `meta.broken` is still inherited
  # from the un-patched 3.14.0 cross python, and nixpkgs' allowBroken
  # gate fires on uv2nix consumers (specifically the
  # `pyproject-cross-shebang-hook` constructor).
  windowsPython = (pkgs.pkgsCross.mingwW64.python314.override {
    self = windowsPython;
  }).overrideAttrs (old: rec {
  # Bump to the version MSYS2's patch series is rebased against.
  version = "3.14.6";
  src = pkgs.fetchurl {
    url = "https://www.python.org/ftp/python/${version}/Python-${version}.tar.xz";
    hash = "sha256-FDsd3e+uw70uIeO4ObNKK3+5hCJyiDxXZCDWBenzDGM=";
  };

  patches =
    (builtins.filter (
      p: !lib.strings.hasInfix "mingw-python" (toString p)
    ) old.patches)
    ++ msys2Patches;

  # nixpkgs' postInstall does `rm $out/bin/{2to3,idle,pydoc}*`; MSYS2
  # patches skip 2to3 entirely, so the glob expands to nothing under
  # nullglob and `rm` errors with "missing operand". Make the deletes
  # tolerant.
  postInstall =
    lib.replaceStrings
      [ "rm $out/bin/2to3*" "rm $out/bin/idle*" "rm $out/bin/pydoc*" ]
      [
        "rm -f $out/bin/2to3* 2>/dev/null || true"
        "rm -f $out/bin/idle* 2>/dev/null || true"
        "rm -f $out/bin/pydoc* 2>/dev/null || true"
      ]
      old.postInstall
    + ''
      # build-details.json (PEP 739) is generated by running the
      # build-host python's sysconfig, so its libpython/c_api paths
      # point at /nix/store/...-python3-3.14.0 instead of $out. That
      # closure ref is rejected by disallowedReferences. Drop the
      # file rather than rewriting paths the user can't trust anyway.
      rm -f $out/lib/python*/build-details.json

      # nixpkgs' `linkDLLsInfolder` only globs `*.{exe,dll}`, so the
      # `.pyd` extension modules in `lib-dynload/` never have their
      # transitive DLL deps (libssl, libsqlite3, …) symlinked next to
      # them. Walk the deps manually and link DLLs into `bin/` (where
      # libpython.dll lives — that directory is on Windows' standard
      # DLL search path because python.exe loads from it).
      local -a _searchPaths
      readarray -td: _searchPaths < <(printf -- "%s" "$LINK_DLL_FOLDERS")
      for pyd in $out/lib/python*/lib-dynload/*.pyd; do
        for dll in $($OBJDUMP -p "$pyd" | sed -n 's/.*DLL Name: \(.*\)/\1/p'); do
          if [ ! -e "$out/bin/$dll" ]; then
            found=$(find -L "''${_searchPaths[@]}" -name "$dll" -type f -print -quit 2>/dev/null || true)
            if [ -n "$found" ]; then
              ln -sr "$found" "$out/bin/$dll"
              echo "lib-dynload dep: $dll -> $found"
            fi
          fi
        done
      done
      # Re-run the standard linker so any new DLLs in bin/ pull their
      # own transitive deps too.
      linkDLLsInfolder $out/bin
    '';

  meta = (old.meta or { }) // {
    broken = false;
  };
  });
in
windowsPython
